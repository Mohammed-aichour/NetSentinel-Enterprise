# NetSentinel Enterprise - Environment Configuration Template
NETSENTINEL_HOST=0.0.0.0
NETSENTINEL_PORT=8080
NETSENTINEL_DEBUG=false
NETSENTINEL_SECRET=your-enterprise-soc-token-change-in-production

# Polling & Telemetry
NETSENTINEL_POLL_INTERVAL=5
NETSENTINEL_HISTORY_LIMIT=120
NETSENTINEL_ICMP_TIMEOUT_MS=1500
NETSENTINEL_TCP_TIMEOUT_S=1.5

# Database
NETSENTINEL_DB_PATH=data/netsentinel.db
